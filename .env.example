# Database
DATABASE_URL="postgresql://user:password@localhost:5432/calcapone"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_USER_ID=""             # your own Telegram user id: the owner (exempt from the trial cap, dev-bypass user)

NEXT_PUBLIC_APP_URL=""

# Web sessions (signed cookie) — generate with: openssl rand -hex 32
SESSION_SECRET=""
# Local dev only: AUTH_DEV_BYPASS=1 signs you in as TELEGRAM_USER_ID without Telegram (ignored in production)
AUTH_DEV_BYPASS=""

# Google OAuth. The Mini App hands consent to the system browser, so the callback is
# authenticated by the signed single-use `state` alone — no cookies cross that boundary.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/settings/google/callback"

# Cron secret (for GitHub Actions → /api/cron/reminders, /api/cron/briefing,
# /api/cron/weekly-digest, /api/cron/sync)
CRON_SECRET=""

# Encryption key for API keys & tokens (32 bytes hex — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=""
# Optional: separate secret for signing OAuth state (falls back to ENCRYPTION_KEY)
OAUTH_STATE_SECRET=""

# Default AI provider (optional — users override via BYOK settings). Only applies to its own provider.
# Supported: openai, anthropic, gemini, openrouter
DEFAULT_AI_PROVIDER="gemini"
DEFAULT_AI_API_KEY=""
DEFAULT_AI_MODEL="gemini-3.7-flash"
# Users on the shared default key get this many AI messages per day (owner + BYOK users exempt)
TRIAL_DAILY_LIMIT="30"

# Semantic search embeddings. Gemini is used when set, otherwise OPENAI_API_KEY.
# All embeddings must come from one model — they share a single vector(768) column — so
# after switching provider, re-run: POST /api/embeddings/backfill  {"all": true}
# Leave both unset to run on keyword search alone.
GEMINI_API_KEY=""

# Also used for voice-note transcription (Whisper), which is OpenAI-only.
OPENAI_API_KEY=""
