        "name": "ribbon",
        "value": "clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 76%, 0 100%)",
        "purpose": "Today's bookmark over the day tab, 10x14px, in the hour."
      }
    ],
    "shadows": [
      {
        "name": "sheet-lift",
        "value": "0 -24px 60px -20px rgba(0,0,0,0.8)",
