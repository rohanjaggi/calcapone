      },
      {
        "name": "float-toast",
        "value": "0 18px 40px -12px rgba(0,0,0,0.7)",
        "purpose": "Toasts."
      },
      {
        "name": "float-search",
        "value": "0 24px 60px -16px rgba(0,0,0,0.85)",
        "purpose": "Search dialog."
      },
      {
        "name": "thumb",
        "value": "0 2px 6px rgba(0,0,0,0.35)",
        "purpose": "Switch thumb."
      },
      {
        "name": "sheet-footer-fade",
        "value": "0 -14px 18px -6px var(--raised)",
        "purpose": "Fades content under the sticky sheet footer."
      },
      {
        "name": "shade",
        "value": "rgba(0,0,0,0.6) + backdrop-filter: blur(2px)",
