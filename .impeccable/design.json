      },
      {
        "name": "rise",
        "value": "520ms ease-out-expo backwards; translateY 10px + blur 4px; late variant +90ms",
        "purpose": "Page headers and the hero."
      },
      {
        "name": "sheet-spring",
        "value": "spring damping 32 stiffness 340; exit 220ms cubic-bezier(0.4,0,1,1); dismiss past 110px or 650px/s",
        "purpose": "Bottom sheet."
      },
      {
        "name": "nav-spring",
        "value": "spring stiffness 420 damping 34",
        "purpose": "Active tab underline."
      },
      {
        "name": "week-spring",
        "value": "spring stiffness 420 damping 36",
        "purpose": "Selected day tile."
      },
      {
        "name": "swipe-spring",
        "value": "spring stiffness 520 damping 42; snaps to -128px",
        "purpose": "Task row actions."
      },
      {
        "name": "toast-in",
        "value": "320ms ease-out-expo, y 16px, blur 6px; exit 160ms",
        "purpose": "Toasts."
      },
      {
        "name": "now-breathe",
        "value": "2.8s cubic-bezier(0.4,0,0.6,1) infinite",
        "purpose": "Now dot pulse."
      },
      {
        "name": "shimmer",
        "value": "1.6s ease-in-out infinite",
        "purpose": "Skeletons."
      },
      {
        "name": "nav-pending",
        "value": "1.1s ease-in-out 250ms delay infinite",
        "purpose": "A tab waiting on its route."
      },
      {
        "name": "stars-fade",
        "value": "opacity 6s ease",
        "purpose": "Stars by phase: night 1, dawn and dusk 0.35, day 0."
      },
      {
        "name": "reduced-motion",
        "value": "no sky transition; foil frozen at 40%; pulse, pending and shimmer off; rise becomes a 200ms fade",
        "purpose": "prefers-reduced-motion."
