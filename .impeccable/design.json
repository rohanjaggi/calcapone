      }
    ],
    "motion": [
      {
        "name": "ease-out-expo",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Default ease for rises, toasts, switch thumb, settings expand, tick draw."
      },
      {
        "name": "sky-crossfade",
        "value": "60s linear",
        "purpose": "Each minute's sky fades into the next."
      },
      {
        "name": "foil-drift",
        "value": "16s ease-in-out infinite alternate",
        "purpose": "The date's sheen."
      },
      {
        "name": "page-in",
        "value": "260ms ease-out backwards (opacity only)",
